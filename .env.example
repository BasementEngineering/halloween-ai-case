# Copy to .env and fill in. .env is git-ignored.
MISTRAL_API_KEY=
# ID of the saved "Red Queen" voice (see docs/mistral-setup.md)
RED_QUEEN_VOICE_ID=
# Written by `npm run agent:sync` (English and German agent)
RED_QUEEN_AGENT_ID=
RED_QUEEN_AGENT_ID_DE=
# The code printed on the prop. Spoken digits are matched too ("alpha seven seven" = ALPHA-77).
RED_QUEEN_CLEARANCE_CODE=ALPHA-77
